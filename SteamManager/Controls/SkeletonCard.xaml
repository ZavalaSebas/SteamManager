<UserControl x:Class="SteamManager.Controls.SkeletonCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="180"
             Cursor="Arrow">

    <UserControl.Resources>
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="MainBorder"
                           Storyboard.TargetProperty="Opacity"
                           From="0.6" To="1" Duration="0:0:0.8"
                           AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="MainBorder"
                CornerRadius="10"
                Background="#1E1E1E"
                Margin="2"
                Opacity="0.8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                 ShadowDepth="0"
                                 Direction="270"
                                 Color="Black"
                                 Opacity="0.3"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource Pulse}"/>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cover Image Placeholder -->
                <Border Grid.Row="0"
                        CornerRadius="10,10,0,0"
                        ClipToBounds="True"
                        Height="105">
                    <Border Background="#252525"/>
                </Border>

                <!-- Text Placeholder -->
                <StackPanel Grid.Row="1" Margin="10,10,10,12">
                    <Border Height="12"
                            Width="130"
                            HorizontalAlignment="Left"
                            CornerRadius="2"
                            Background="#2A2A2A"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
