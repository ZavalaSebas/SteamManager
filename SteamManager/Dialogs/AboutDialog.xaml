<Window x:Class="SteamManager.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About SteamManager"
        Width="450"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20"
                         ShadowDepth="3"
                         Direction="270"
                         Color="Black"
                         Opacity="0.3"/>
    </Window.Effect>

    <Border Background="#252525"
            CornerRadius="10"
            Margin="16">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="48" Height="48"
                        Background="#2A2A2A"
                        CornerRadius="10"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE7FC;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="#66C0F4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="SteamManager"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"/>
                    <TextBlock x:Name="VersionText"
                               Text=""
                               FontSize="12"
                               Foreground="#6B6B6B"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Description -->
            <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#8A8A8A"
                       LineHeight="22"
                       Margin="0,0,0,16">
                A modern Windows desktop application for managing Steam game achievements and statistics.
                Built with C# / .NET 10 and WPF, using the official Steamworks API via steamclient.dll.
            </TextBlock>

            <!-- Credits Section -->
            <TextBlock Text="Credits"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#66C0F4"
                       Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#8A8A8A"
                       LineHeight="20"
                       Margin="0,0,0,8">
                Inspired by Gibbed's Steam Achievement Manager (SAM), the original tool that pioneered Steam achievement management since 2008.
            </TextBlock>

            <!-- Disclaimer -->
            <Border Background="#1A1A1A"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="#6B6B6B"
                           LineHeight="18">
                    This tool uses the official Steamworks API. You are solely responsible for complying with Steam's Terms of Service. Use at your own risk.
                </TextBlock>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Support (Ko-fi)"
                        Padding="16,10"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="Support_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3A1A1A"/>
                            <Setter Property="Foreground" Value="#E74C3C"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#4A2A2A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Close"
                        Padding="20,10"
                        Cursor="Hand"
                        Click="Close_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#66C0F4"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
