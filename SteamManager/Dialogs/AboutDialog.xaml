<ui:FluentWindow x:Class="SteamManager.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="About SteamManager"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1A1A"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0"
                Height="48"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BC;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="#66C0F4"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="About SteamManager"
                               FontSize="13"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ui:TitleBar Grid.Column="2"
                             ShowMinimize="False"
                             ShowMaximize="False"
                             ShowClose="True"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,12,24,0">
            <StackPanel>

            <!-- App Info Card -->
            <Border Background="#1E1E1E"
                    CornerRadius="10"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                      Direction="270" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56"
                                Background="#2A2A2A"
                                CornerRadius="12"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE7BC;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="28"
                                       Foreground="#66C0F4"
                                       HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                         </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="SteamManager"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="#FFFFFF"/>
                            <TextBlock x:Name="VersionText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="#8A8A8A"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#AAAAAA"
                               LineHeight="22"
                               Margin="0,16,0,0">
                        A modern Windows desktop application for managing Steam game achievements and statistics.
                        Built with C# / .NET 10 and WPF, using the official Steamworks API via steamclient.dll.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- How it Works Card -->
            <Border Background="#1E1E1E"
                    CornerRadius="10"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                      Direction="270" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="3" Height="18" CornerRadius="1.5" Margin="0,0,10,0"
                                Background="#66C0F4"/>
                        <TextBlock Text="How it"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" works"
                                   FontSize="16" FontWeight="Light"
                                   Foreground="#66C0F4"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#AAAAAA"
                               LineHeight="22">
                        Select any game from your library to open its achievement manager.
                        Browse achievements, use Smart Unlock for safe unlocking with built-in delays,
                        or manually lock and unlock individual achievements.
                        All changes sync instantly with your Steam profile.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Credits Card -->
            <Border Background="#1E1E1E"
                    CornerRadius="10"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                      Direction="270" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="3" Height="18" CornerRadius="1.5" Margin="0,0,10,0"
                                Background="#66C0F4"/>
                        <TextBlock Text="Credits"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#AAAAAA"
                               LineHeight="22">
                        Inspired by <Run FontWeight="SemiBold" Foreground="#C0C0C0">Gibbed's Steam Achievement Manager (SAM)</Run>,
                        the original tool that pioneered Steam achievement management since 2008.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Support Card -->
            <Border Background="#1E1E1E"
                    CornerRadius="10"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                      Direction="270" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="3" Height="18" CornerRadius="1.5" Margin="0,0,10,0"
                                Background="#E74C3C"/>
                        <TextBlock Text="Support"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" the project"
                                   FontSize="16" FontWeight="Light"
                                   Foreground="#E74C3C"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#AAAAAA"
                               LineHeight="22"
                               Margin="0,0,0,16">
                        SteamManager is free and open-source. Your support keeps the project alive!
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SupportButton"
                                Padding="16,10"
                                FontSize="12"
                                Cursor="Hand"
                                Click="Support_Click"
                                ToolTip="Support on Ko-fi">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#66C0F4"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}"
                                                        Cursor="Hand">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE00E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="  Buy me a coffee"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="GitHubSponsorButton"
                                Padding="14,10"
                                FontSize="12"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                Click="GitHubSponsor_Click"
                                ToolTip="Sponsor on GitHub">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#E74C3C"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Cursor="Hand">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3A1A1A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB51;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="  GitHub Sponsor"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Made with care -->
            <TextBlock Text="Made with care by ZavalaSebas"
                       FontSize="11"
                       Foreground="#6B6B6B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <!-- Close button -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,20">
                <Button Content="Close"
                        Padding="20,10"
                        FontSize="12"
                        Cursor="Hand"
                        Click="Close_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#66C0F4"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
