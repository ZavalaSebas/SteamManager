<UserControl x:Class="SteamManager.Dialogs.ProgressOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <!-- Semi-transparent backdrop -->
        <Border Background="#CC1A1A1A"/>

        <!-- Centered Progress Panel -->
        <Border Background="#252525"
                CornerRadius="12"
                Padding="32,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="380">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                 ShadowDepth="5"
                                 Direction="270"
                                 Color="Black"
                                 Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <!-- Header with icon and title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Border Width="44" Height="44"
                            Background="#1A1A1A"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE785;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="#66C0F4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Smart Unlock in Progress"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="Please wait..."
                                   FontSize="12"
                                   Foreground="#6B6B6B"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Progress Bar -->
                <Border Background="#1A1A1A"
                        CornerRadius="4"
                        Height="8"
                        Margin="0,0,0,20">
                    <Border x:Name="ProgressBarFill"
                            Background="#66C0F4"
                            CornerRadius="4"
                            HorizontalAlignment="Left"
                            Width="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                             ShadowDepth="0"
                                             Color="#66C0F4"
                                             Opacity="0.5"/>
                        </Border.Effect>
                    </Border>
                </Border>

                <!-- Live Counters -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Applied Counter -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="AppliedValueText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#2ECC71"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Applied"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="/"
                               Foreground="#3A3A3A"
                               FontSize="20"
                               VerticalAlignment="Bottom"
                               Margin="8,0"/>

                    <!-- Protected Counter -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="ProtectedValueText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#F39C12"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Protected"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3"
                               Text="/"
                               Foreground="#3A3A3A"
                               FontSize="20"
                               VerticalAlignment="Bottom"
                               Margin="8,0"/>

                    <!-- Failed Counter -->
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="FailedValueText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#E74C3C"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Failed"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Status Message -->
                <TextBlock x:Name="StatusMessageText"
                           Text="Smart Unlock: 0/0 achievements processed (0 protected, 0 failed)"
                           FontSize="12"
                           Foreground="#8A8A8A"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <!-- Cancel Button -->
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Padding="24,10"
                        HorizontalAlignment="Center"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2A2A2A"/>
                            <Setter Property="Foreground" Value="#B0B0B0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
