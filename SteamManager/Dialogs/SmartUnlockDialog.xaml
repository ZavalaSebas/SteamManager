<Window x:Class="SteamManager.Dialogs.SmartUnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Smart Unlock Settings"
        Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1A1A1A">
    <Window.Effect>
        <DropShadowEffect BlurRadius="25"
                         ShadowDepth="4"
                         Direction="270"
                         Color="Black"
                         Opacity="0.35"/>
    </Window.Effect>

    <Border Background="#252525"
            CornerRadius="10"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                             ShadowDepth="2"
                             Direction="270"
                             Color="Black"
                             Opacity="0.25"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="40" Height="40"
                        Background="#2A2A2A"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE785;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="#66C0F4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Smart Unlock"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="Configure unlock behavior"
                               FontSize="12"
                               Foreground="#6B6B6B"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Delay Configuration -->
            <TextBlock Grid.Row="1"
                       Text="Anti-Detection Delay"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#B0B0B0"
                       Margin="0,0,0,10"/>

            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Min Delay -->
                <Border Grid.Column="0"
                        Background="#1A1A1A"
                        CornerRadius="6"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Min delay (seconds)"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="MinDelayTextBox"
                                 Text="15"
                                 Background="Transparent"
                                 Foreground="#FFFFFF"
                                 BorderThickness="0"
                                 FontSize="14"
                                 CaretBrush="#66C0F4"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="1"
                           Text="to"
                           Foreground="#4A4A4A"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,14"/>

                <!-- Max Delay -->
                <Border Grid.Column="2"
                        Background="#1A1A1A"
                        CornerRadius="6"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Max delay (seconds)"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="MaxDelayTextBox"
                                 Text="45"
                                 Background="Transparent"
                                 Foreground="#FFFFFF"
                                 BorderThickness="0"
                                 FontSize="14"
                                 CaretBrush="#66C0F4"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Overlay Checkbox -->
            <CheckBox x:Name="ShowOverlayCheckBox"
                      Grid.Row="3"
                      IsChecked="True"
                      VerticalAlignment="Top"
                      Margin="0,0,0,16">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="checkBorder"
                                                Width="20" Height="20"
                                                Background="#1A1A1A"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="checkMark"
                                                       Text="&#xE73E;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="#66C0F4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Show Steam overlay progress"
                                                       FontSize="13"
                                                       Foreground="#FFFFFF"/>
                                            <TextBlock Text="Display in-game achievement notifications"
                                                       FontSize="11"
                                                       Foreground="#6B6B6B"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="#66C0F4"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="#4A4A4A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <!-- Buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Padding="20,10"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2A2A2A"/>
                            <Setter Property="Foreground" Value="#B0B0B0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="StartButton"
                        Content="Start Smart Unlock"
                        Padding="20,10"
                        Margin="10,0,0,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#66C0F4"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1A4D7C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
