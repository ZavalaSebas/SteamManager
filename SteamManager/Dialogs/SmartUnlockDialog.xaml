<ui:FluentWindow x:Class="SteamManager.Dialogs.SmartUnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Smart Unlock Settings"
        Height="340" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1A1A1A"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0"
                Height="48"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32"
                            Background="#2A2A2A"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE785;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#66C0F4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Smart Unlock"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="Configure unlock behavior"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ui:TitleBar Grid.Column="2"
                             ShowMinimize="False"
                             ShowMaximize="False"
                             ShowClose="True"/>
            </Grid>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,12,24,24">

            <TextBlock Text="Anti-Detection Delay"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#B0B0B0"/>

            <Grid Margin="0,12,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Min Delay -->
                <Border Grid.Column="0"
                        Background="#1A1A1A"
                        CornerRadius="6"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Min delay (seconds)"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="MinDelayTextBox"
                                 Text="15"
                                 Background="Transparent"
                                 Foreground="#FFFFFF"
                                 BorderThickness="0"
                                 FontSize="14"
                                 CaretBrush="#66C0F4"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="1"
                           Text="to"
                           Foreground="#4A4A4A"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,14"/>

                <!-- Max Delay -->
                <Border Grid.Column="2"
                        Background="#1A1A1A"
                        CornerRadius="6"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Max delay (seconds)"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="MaxDelayTextBox"
                                 Text="45"
                                 Background="Transparent"
                                 Foreground="#FFFFFF"
                                 BorderThickness="0"
                                 FontSize="14"
                                 CaretBrush="#66C0F4"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Overlay Checkbox -->
            <CheckBox x:Name="ShowOverlayCheckBox"
                      IsChecked="True"
                      VerticalAlignment="Top"
                      Margin="0,0,0,16">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="checkBorder"
                                                Width="20" Height="20"
                                                Background="#1A1A1A"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="checkMark"
                                                       Text="&#xE73E;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="#66C0F4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Show Steam overlay progress"
                                                       FontSize="13"
                                                       Foreground="#FFFFFF"/>
                                            <TextBlock Text="Display in-game achievement notifications"
                                                       FontSize="11"
                                                       Foreground="#6B6B6B"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="#66C0F4"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="#4A4A4A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Padding="20,10"
                        Cursor="Hand"
                        Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2A2A2A"/>
                            <Setter Property="Foreground" Value="#B0B0B0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="StartButton"
                        Content="Start Smart Unlock"
                        Padding="20,10"
                        Margin="10,0,0,0"
                        Cursor="Hand"
                        Click="StartButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#66C0F4"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1A4D7C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
