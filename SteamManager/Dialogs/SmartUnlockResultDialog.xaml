<Window x:Class="SteamManager.Dialogs.SmartUnlockResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Smart Unlock Complete"
        Height="340" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1A1A1A">
    <Window.Effect>
        <DropShadowEffect BlurRadius="25"
                         ShadowDepth="4"
                         Direction="270"
                         Color="Black"
                         Opacity="0.35"/>
    </Window.Effect>

    <Border Background="#252525"
            CornerRadius="10"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                             ShadowDepth="2"
                             Direction="270"
                             Color="Black"
                             Opacity="0.25"/>
        </Border.Effect>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with conditional icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                <Border x:Name="IconBorder"
                        Width="48" Height="48"
                        CornerRadius="24"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2A3A2A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                    <Setter Property="Background" Value="#3A2A2A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Success checkmark (shown when clean) -->
                        <TextBlock x:Name="SuccessIcon"
                                   Text="&#xE73E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#2ECC71"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <!-- Warning icon (shown when problems) -->
                        <TextBlock x:Name="WarningIcon"
                                   Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#F39C12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText"
                               Text="Smart Unlock Complete"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"/>
                    <TextBlock x:Name="SubheaderText"
                               Text="All achievements unlocked successfully"
                               FontSize="12"
                               Foreground="#6B6B6B"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Result Counters -->
            <Border Grid.Row="1"
                    Background="#1A1A1A"
                    CornerRadius="8"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="AppliedResultText"
                                   Text="0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#2ECC71"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Applied"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="/"
                               Foreground="#3A3A3A"
                               FontSize="18"
                               VerticalAlignment="Bottom"
                               Margin="10,0"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="ProtectedResultText"
                                   Text="0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#F39C12"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Protected"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3"
                               Text="/"
                               Foreground="#3A3A3A"
                               FontSize="18"
                               VerticalAlignment="Bottom"
                               Margin="10,0"/>

                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="FailedResultText"
                                   Text="0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#E74C3C"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Failed"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Warning Message (shown when problems) -->
            <Border x:Name="WarningPanel"
                    Grid.Row="2"
                    Background="#2A2520"
                    BorderBrush="#F39C12"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#F39C12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="WarningText"
                               Text="Some achievements could not be unlocked."
                               FontSize="13"
                               Foreground="#B0B0B0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Spacer -->
            <Border Grid.Row="3"/>

            <!-- Close Button -->
            <Button x:Name="CloseButton"
                    Content="Close"
                    Padding="24,10"
                    HorizontalAlignment="Center"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2A2A2A"/>
                        <Setter Property="Foreground" Value="#B0B0B0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
