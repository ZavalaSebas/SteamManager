<Window x:Class="SteamManager.Dialogs.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Update Available"
        Height="300" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1A1A1A">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20"
                         ShadowDepth="3"
                         Direction="270"
                         Color="Black"
                         Opacity="0.3"/>
    </Window.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#252525"
                BorderBrush="#3A3A3A"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40"
                        Background="#2A2A2A"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE7FC;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="#66C0F4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Update Available"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#66C0F4"/>
                    <TextBlock x:Name="VersionText"
                               Text=""
                               FontSize="12"
                               Foreground="#6B6B6B"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0">

            <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#8A8A8A"
                       LineHeight="20"
                       Margin="0,0,0,16">
                A new version of SteamManager is ready to install. Would you like to download it now?
            </TextBlock>

            <!-- Progress -->
            <StackPanel x:Name="ProgressPanel"
                        Visibility="Collapsed"
                        Margin="0,0,0,0">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Downloading..."
                               FontSize="11"
                               Foreground="#8A8A8A"/>
                    <TextBlock x:Name="ProgressText"
                               Grid.Column="1"
                               Text="0%"
                               FontSize="11"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"/>
                </Grid>
                <Border Background="#1A1A1A"
                        CornerRadius="3"
                        Height="4">
                    <Border x:Name="ProgressBar"
                            Background="#66C0F4"
                            CornerRadius="3"
                            Height="4"
                            HorizontalAlignment="Left"
                            Width="0"/>
                </Border>
            </StackPanel>

        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#252525"
                BorderBrush="#3A3A3A"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="SkipButton"
                        Grid.Column="0"
                        Content="Skip"
                        Padding="20,10"
                        Cursor="Hand"
                        Click="Skip_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#8A8A8A"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="UpdateButton"
                        Grid.Column="2"
                        Content="Update Now"
                        Padding="20,10"
                        Cursor="Hand"
                        Click="UpdateNow_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#66C0F4"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
