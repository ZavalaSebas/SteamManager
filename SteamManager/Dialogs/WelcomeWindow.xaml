<ui:FluentWindow x:Class="SteamManager.Dialogs.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Welcome to SteamManager"
        Height="540" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A1A1A"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0"
                Height="48"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BC;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="#66C0F4"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Welcome to SteamManager"
                               FontSize="13"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ui:TitleBar Grid.Column="2"
                             ShowMinimize="False"
                             ShowMaximize="False"
                             ShowClose="True"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,12,24,0">
            <StackPanel>

            <!-- App Info Card -->
            <Border Background="#1E1E1E"
                    CornerRadius="10"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                      Direction="270" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56"
                            Background="#2A2A2A"
                            CornerRadius="12"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BC;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="#66C0F4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="SteamManager"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock x:Name="VersionText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="#8A8A8A"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- What's New Section -->
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                    <Border Width="3" Height="28" CornerRadius="1.5" Margin="0,0,12,0"
                            Background="#66C0F4"/>
                    <TextBlock Text="What's"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" New"
                               FontSize="28" FontWeight="Light"
                               Foreground="#66C0F4"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="CardWhatsNew" Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                          Direction="270" Color="Black" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="WhatsNewHeader"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#66C0F4"
                                   Margin="0,0,0,12"/>
                        <StackPanel x:Name="WhatsNewItems"/>
                    </StackPanel>
                </Border>

                <!-- How It Works Section -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="3" Height="28" CornerRadius="1.5" Margin="0,0,12,0"
                            Background="#66C0F4"/>
                    <TextBlock Text="How it"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" works"
                               FontSize="28" FontWeight="Light"
                               Foreground="#66C0F4"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="CardHowItWorks" Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                          Direction="270" Color="Black" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Powered by steamclient.dll"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#8A8A8A"
                                   Margin="0,0,0,8"/>
                        <TextBlock FontSize="13"
                                   Foreground="#C0C0C0"
                                   TextWrapping="Wrap"
                                   LineHeight="22">
                            SteamManager uses the official Steamworks API via steamclient.dll,
                            the same internal library used by the original Steam Achievement Manager.
                            Browse your library, select achievements to unlock or lock, and use
                            Smart Unlock for anti-detection delays.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Support Section -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="3" Height="28" CornerRadius="1.5" Margin="0,0,12,0"
                            Background="#E74C3C"/>
                    <TextBlock Text="Support"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" the project"
                               FontSize="28" FontWeight="Light"
                               Foreground="#E74C3C"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="CardSupport" Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                          Direction="270" Color="Black" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="#C0C0C0"
                                   LineHeight="20"
                                   Margin="0,0,0,16">
                            SteamManager is free and open-source.
                            Your support keeps the project alive!
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="KofiButton"
                                    Padding="16,10"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Click="Kofi_Click"
                                    ToolTip="Support on Ko-fi">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#66C0F4"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE00E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="  Buy me a coffee"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="GitHubSponsorButton"
                                    Padding="14,10"
                                    FontSize="12"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    Click="GitHubSponsor_Click"
                                    ToolTip="Sponsor on GitHub">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#3A1A1A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB51;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="  GitHub Sponsor"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border x:Name="FooterBorder" Grid.Row="2"
                Background="#1E1E1E"
                BorderBrush="#2A2A2A"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2"
                                  Direction="0" Color="Black" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="DontShowAgainCheck"
                          Grid.Column="0"
                          IsChecked="True"
                          Foreground="#6B6B6B"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Content="Don't show again"/>

                <Button x:Name="BtnGetStarted" Grid.Column="2"
                        Content="Get Started"
                        Padding="20,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="GetStarted_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#66C0F4"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
