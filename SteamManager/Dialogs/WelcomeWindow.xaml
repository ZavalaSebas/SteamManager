<Window x:Class="SteamManager.Dialogs.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thanks for downloading SteamManager"
        Height="520" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A1A1A"
        ShowInTaskbar="False">

    <Window.Effect>
        <DropShadowEffect BlurRadius="25"
                         ShadowDepth="4"
                         Direction="270"
                         Color="Black"
                         Opacity="0.35"/>
    </Window.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="HeaderBorder" Grid.Row="0"
                Background="#252525"
                BorderBrush="#3A3A3A"
                BorderThickness="0,0,0,1"
                Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40"
                        Background="#2A2A2A"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE7FC;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="#66C0F4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Thanks for downloading SteamManager!"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="Your Steam library, your rules"
                               FontSize="12"
                               Foreground="#6B6B6B"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,0">

                <!-- What's New Card -->
                <Border x:Name="CardWhatsNew"
                        Background="#252525"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="WhatsNewHeader"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#66C0F4"
                                   Margin="0,0,0,10"/>
                        <StackPanel x:Name="WhatsNewItems"/>
                    </StackPanel>
                </Border>

                <!-- How It Works Card -->
                <Border x:Name="CardHowItWorks"
                        Background="#252525"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="How it works"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#66C0F4"
                                   Margin="0,0,0,8"/>
                        <TextBlock FontSize="12"
                                   Foreground="#8A8A8A"
                                   TextWrapping="Wrap"
                                   LineHeight="20">
                            SteamManager uses the official Steamworks API via steamclient.dll,
                            the same internal library used by the original Steam Achievement Manager.
                            Browse your library, select achievements to unlock or lock, and use
                            Smart Unlock for anti-detection delays.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Support Card -->
                <Border x:Name="CardSupport"
                        Background="#252525"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Support the project"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#E74C3C"
                                   Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#8A8A8A"
                                   LineHeight="18"
                                   Margin="0,0,0,12">
                            SteamManager is free and open-source.
                            Your support keeps the project alive!
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    x:Name="KofiButton"
                                    Content="Buy me a coffee"
                                    Padding="14,8"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Click="Kofi_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#66C0F4"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2"
                                    x:Name="GitHubSponsorButton"
                                    Content="GitHub Sponsor"
                                    Padding="14,8"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Click="GitHubSponsor_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#3A1A1A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border x:Name="FooterBorder" Grid.Row="2"
                Background="#252525"
                BorderBrush="#3A3A3A"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="DontShowAgainCheck"
                          Grid.Column="0"
                          IsChecked="True"
                          VerticalAlignment="Center">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="checkBorder"
                                                    Width="18" Height="18"
                                                    Background="#1A1A1A"
                                                    BorderBrush="#3A3A3A"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="checkMark"
                                                           Text="&#xE73E;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           Foreground="#66C0F4"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </Border>
                                            <TextBlock Text="Don't show again"
                                                       FontSize="12"
                                                       Foreground="#6B6B6B"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#66C0F4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <Button x:Name="BtnGetStarted" Grid.Column="2"
                        Content="Get Started"
                        Padding="20,10"
                        Cursor="Hand"
                        Click="GetStarted_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#66C0F4"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
