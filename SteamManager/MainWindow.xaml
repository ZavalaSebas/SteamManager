<ui:FluentWindow x:Class="SteamManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SteamManager"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:SteamManager.Views"
        mc:Ignorable="d"
        Title="SteamManager"
         Icon="Resources/SM.ico"
         Height="750" Width="1150"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <!-- Mica Backdrop -->
        <Grid.Background>
            <SolidColorBrush Color="#1A1A1A"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0"
              Height="48"
              Background="#1A1A1A"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Hamburger Menu Button -->
            <Button x:Name="HamburgerButton"
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    Padding="8,6"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="HamburgerMenu_Click"
                    ToolTip="Menu">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="&#xE700;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="16"
                                                  Foreground="#8A8A8A"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                            <Setter TargetName="border" Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- App Icon & Title -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="&#xE7BC;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="20"
                           Foreground="#66C0F4"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="SteamManager"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Spacer -->
            <Border Grid.Column="2"/>

            <!-- Window Controls -->
            <ui:TitleBar Grid.Column="3"
                         ShowMinimize="True"
                         ShowMaximize="True"
                         ShowClose="True"/>

            <!-- Hamburger Popup Menu -->
            <Popup x:Name="HamburgerPopup"
                   PlacementTarget="{Binding ElementName=HamburgerButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="#252525"
                        BorderBrush="#3A3A3A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4"
                        Margin="0,4,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20"
                                         ShadowDepth="3"
                                         Direction="270"
                                         Color="Black"
                                         Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel MinWidth="180">
                        <Button x:Name="AboutMenuItem"
                                Content="About &amp; Credits"
                                Padding="12,10"
                                Cursor="Hand"
                                HorizontalContentAlignment="Left"
                                Click="AboutMenuItem_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="CheckUpdatesMenuItem"
                                Content="Check for Updates"
                                Padding="12,10"
                                Cursor="Hand"
                                HorizontalContentAlignment="Left"
                                Click="CheckUpdatesMenuItem_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Separator Background="#3A3A3A" Margin="8,4"/>
                        <TextBlock Text="Support"
                                   FontSize="11"
                                   Foreground="#6B6B6B"
                                   Margin="12,4,12,6"/>
                        <Button x:Name="KofiMenuItem"
                                Content="Ko-fi"
                                Padding="12,10"
                                Cursor="Hand"
                                HorizontalContentAlignment="Left"
                                Click="KofiMenuItem_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3A1A1A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="GitHubSponsorMenuItem"
                                Content="GitHub Sponsors"
                                Padding="12,10"
                                Cursor="Hand"
                                HorizontalContentAlignment="Left"
                                Click="GitHubSponsorMenuItem_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3A1A1A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Main Content -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentViewModel}"
                        Margin="0"/>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#1E1E1E"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#6B6B6B"
                           VerticalAlignment="Center"/>

                <!-- Steam Badge & Support -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Powered by"
                               FontSize="11"
                               Foreground="#5A5A5A"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Steam"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#66C0F4"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="|"
                               FontSize="11"
                               Foreground="#3A3A3A"
                               Margin="12,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeartButton"
                                Text="&#xEB51;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="#E74C3C"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                MouseLeftButtonDown="Heart_Click">
                        <TextBlock.ToolTip>
                            <ToolTip FontFamily="Segoe UI" Content="Support SteamManager on Ko-fi"/>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
