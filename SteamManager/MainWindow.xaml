<ui:FluentWindow x:Class="SteamManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SteamManager"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:SteamManager.Views"
        mc:Ignorable="d"
        Title="SteamManager"
        Height="750" Width="1150"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <!-- Mica Backdrop -->
        <Grid.Background>
            <SolidColorBrush Color="#1A1A1A"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0"
              Height="48"
              Background="#1A1A1A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Icon & Title -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="&#xE7BC;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="20"
                           Foreground="#66C0F4"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="SteamManager"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Spacer -->
            <Border Grid.Column="1"/>

            <!-- Window Controls -->
            <ui:TitleBar Grid.Column="2"
                         ShowMinimize="True"
                         ShowMaximize="True"
                         ShowClose="True"/>
        </Grid>

        <!-- Main Content -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentViewModel}"
                        Margin="0"/>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#1E1E1E"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#6B6B6B"
                           VerticalAlignment="Center"/>

                <!-- Steam Badge -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Powered by"
                               FontSize="11"
                               Foreground="#5A5A5A"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Steam"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#66C0F4"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
