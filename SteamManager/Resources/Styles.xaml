<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Steam-Inspired Color Palette -->
    <Color x:Key="SteamBlueAccent">#66C0F4</Color>
    <Color x:Key="SteamBlueDark">#1A4D7C</Color>
    <Color x:Key="SteamBlueBright">#8FCDFF</Color>
    <Color x:Key="BackgroundPrimary">#1A1A1A</Color>
    <Color x:Key="BackgroundSecondary">#252525</Color>
    <Color x:Key="BackgroundCard">#2A2A2A</Color>
    <Color x:Key="BackgroundElevated">#323232</Color>
    <Color x:Key="BorderSubtle">#3A3A3A</Color>
    <Color x:Key="BorderHover">#4A4A4A</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#B0B0B0</Color>
    <Color x:Key="TextMuted">#6B6B6B</Color>
    <Color x:Key="UnlockGreen">#2ECC71</Color>
    <Color x:Key="LockRed">#E74C3C</Color>
    <Color x:Key="FavoriteGold">#FFD700</Color>
    <Color x:Key="HiddenPurple">#9B59B6</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="BackgroundCardBrush" Color="{StaticResource BackgroundCard}"/>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="{StaticResource BackgroundElevated}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHover}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="SteamBlueBrush" Color="{StaticResource SteamBlueAccent}"/>
    <SolidColorBrush x:Key="SteamBlueDarkBrush" Color="{StaticResource SteamBlueDark}"/>
    <SolidColorBrush x:Key="SteamBlueBrightBrush" Color="{StaticResource SteamBlueBright}"/>
    <SolidColorBrush x:Key="UnlockGreenBrush" Color="{StaticResource UnlockGreen}"/>
    <SolidColorBrush x:Key="LockRedBrush" Color="{StaticResource LockRed}"/>
    <SolidColorBrush x:Key="FavoriteGoldBrush" Color="{StaticResource FavoriteGold}"/>
    <SolidColorBrush x:Key="HiddenPurpleBrush" Color="{StaticResource HiddenPurple}"/>

    <!-- Background Gradient (subtle depth) -->
    <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A1A1A" Offset="0"/>
        <GradientStop Color="#1E1E1E" Offset="0.3"/>
        <GradientStop Color="#1A1A1A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Steam Blue Gradient -->
    <LinearGradientBrush x:Key="SteamBlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66C0F4" Offset="0"/>
        <GradientStop Color="#417A9B" Offset="1"/>
    </LinearGradientBrush>

    <!-- Header Accent Gradient -->
    <LinearGradientBrush x:Key="HeaderAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#66C0F4" Offset="0"/>
        <GradientStop Color="#8FCDFF" Offset="0.5"/>
        <GradientStop Color="#66C0F4" Offset="1"/>
    </LinearGradientBrush>

    <!-- Unlock Success Gradient -->
    <LinearGradientBrush x:Key="UnlockGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2ECC71" Offset="0"/>
        <GradientStop Color="#27AE60" Offset="1"/>
    </LinearGradientBrush>

    <!-- Lock Danger Gradient -->
    <LinearGradientBrush x:Key="LockGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E74C3C" Offset="0"/>
        <GradientStop Color="#C0392B" Offset="1"/>
    </LinearGradientBrush>

    <!-- Button Styles -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SteamBlueBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SteamBlueBrightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SteamBlueDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom ScrollBar (thin & subtle) -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#4A4A4A"
                                                    CornerRadius="3"
                                                    Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinHeight" Value="6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                  Grid.Column="1"
                                  Style="{StaticResource ThinScrollBar}"
                                  Orientation="Vertical"
                                  Value="{TemplateBinding VerticalOffset}"
                                  Maximum="{TemplateBinding ScrollableHeight}"
                                  ViewportSize="{TemplateBinding ViewportHeight}"
                                  Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
