<UserControl x:Class="SteamManager.Views.GameManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SteamManager.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:SteamManager.Dialogs"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#1A1A1A">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Game Info -->
        <Border Grid.Row="0"
                Background="#1E1E1E"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                 ShadowDepth="3"
                                 Direction="270"
                                 Color="Black"
                                 Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Back to Game Library">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2A2A2A"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="10"
                                                Cursor="Hand">
                                            <TextBlock Text="&#xE72B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="#8A8A8A"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Game Thumbnail -->
                <Border Grid.Column="1"
                        Width="64"
                        Height="64"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Background="#252525"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <Image Source="{Binding SelectedGame.CoverImage}"
                           Stretch="UniformToFill"/>
                </Border>

                <!-- Game Title & Stats -->
                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3"
                                Height="28"
                                CornerRadius="2"
                                Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#66C0F4" Offset="0"/>
                                    <GradientStop Color="#417A9B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding SelectedGame.Name}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="18,8,0,0">
                        <!-- Achievement Progress Circle -->
                        <Grid Width="22" Height="22">
                            <Ellipse Stroke="#3A3A3A" StrokeThickness="2.5" Fill="Transparent"/>
                            <Path Stroke="#66C0F4"
                                  StrokeThickness="2.5"
                                  Fill="Transparent"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round">
                                <Path.Data>
                                    <MultiBinding Converter="{StaticResource PercentToArcMultiConverter}">
                                        <Binding Path="UnlockedCount"/>
                                        <Binding Path="TotalCount"/>
                                    </MultiBinding>
                                </Path.Data>
                            </Path>
                        </Grid>
                        <TextBlock Foreground="#8A8A8A" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Run Text="{Binding UnlockedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#2ECC71"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                            <Run Text=" achievements"/>
                        </TextBlock>
                        <TextBlock Foreground="#4A4A4A"
                                   Margin="12,0"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock Foreground="#66C0F4"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource PercentToTextMultiConverter}">
                                    <Binding Path="UnlockedCount"/>
                                    <Binding Path="TotalCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding LockAllCommand}"
                            Padding="14,8"
                            Cursor="Hand"
                            ToolTip="Lock all selected (or all if none selected)">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#E74C3C"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72E;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="14"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"/>
                                                    <TextBlock Text="Lock All"
                                                              FontSize="13"
                                                              FontWeight="SemiBold"
                                                              VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#3A2A2A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="UnlockDropdownButton"
                            Margin="8,0,0,0"
                            Padding="14,8"
                            Cursor="Hand"
                            ToolTip="Unlock options"
                            Click="UnlockDropdownButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2A3A2A"/>
                                <Setter Property="Foreground" Value="#2ECC71"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE785;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="14"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"/>
                                                    <TextBlock Text="Unlock"
                                                              FontSize="13"
                                                              FontWeight="SemiBold"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xE70D;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="10"
                                                              Foreground="#2ECC71"
                                                              VerticalAlignment="Center"
                                                              Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#3A4A3A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="UnlockContextMenu"
                                        Background="#252525"
                                        BorderBrush="#3A3A3A"
                                        BorderThickness="1"
                                        Padding="0,4">
                                <MenuItem Header="Unlock All"
                                         Command="{Binding UnlockAllCommand}"
                                         FontSize="13"
                                         Foreground="#FFFFFF"
                                         Padding="12,8"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Cursor="Hand">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE785;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="12"
                                                  Foreground="#2ECC71"
                                                  VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Smart Unlock..."
                                         x:Name="SmartUnlockMenuItem"
                                         FontSize="13"
                                         Foreground="#FFFFFF"
                                         Padding="12,8"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Cursor="Hand"
                                         Click="SmartUnlockMenuItem_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE79F;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="12"
                                                  Foreground="#66C0F4"
                                                  VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="#252525"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Selection Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding SelectAllCommand}"
                            Padding="10,6"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="Select All"
                                                          FontSize="12"
                                                          Foreground="#8A8A8A"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding DeselectAllCommand}"
                            Padding="10,6"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="Deselect"
                                                          FontSize="12"
                                                          Foreground="#8A8A8A"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="|"
                           Foreground="#3A3A3A"
                           FontSize="14"
                           Margin="12,0"
                           VerticalAlignment="Center"/>

                <!-- Filter Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding SetFilterAllCommand}"
                            Cursor="Hand"
                            Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{Binding AchievementFilter, Converter={StaticResource FilterToBackgroundConverter}, ConverterParameter=All}"/>
                                <Setter Property="Foreground" Value="{Binding AchievementFilter, Converter={StaticResource FilterToForegroundConverter}, ConverterParameter=All}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="All"
                                                          FontSize="12"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#5A5A5A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetFilterUnlockedCommand}"
                            Margin="6,0,0,0"
                            Cursor="Hand"
                            Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{Binding AchievementFilter, Converter={StaticResource FilterToBackgroundConverter}, ConverterParameter=Unlocked}"/>
                                <Setter Property="Foreground" Value="{Binding AchievementFilter, Converter={StaticResource FilterToForegroundConverter}, ConverterParameter=Unlocked}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="Unlocked"
                                                          FontSize="12"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#5A5A5A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetFilterLockedCommand}"
                            Margin="6,0,0,0"
                            Cursor="Hand"
                            Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{Binding AchievementFilter, Converter={StaticResource FilterToBackgroundConverter}, ConverterParameter=Locked}"/>
                                <Setter Property="Foreground" Value="{Binding AchievementFilter, Converter={StaticResource FilterToForegroundConverter}, ConverterParameter=Locked}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="Locked"
                                                          FontSize="12"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#5A5A5A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetFilterHiddenCommand}"
                            Margin="6,0,0,0"
                            Cursor="Hand"
                            Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{Binding AchievementFilter, Converter={StaticResource FilterToBackgroundConverter}, ConverterParameter=Hidden}"/>
                                <Setter Property="Foreground" Value="{Binding AchievementFilter, Converter={StaticResource FilterToForegroundConverter}, ConverterParameter=Hidden}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="Hidden"
                                                          FontSize="12"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#5A5A5A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Loading Indicator -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True"
                                 Width="60"
                                 Height="4"
                                 Foreground="#66C0F4"
                                 Background="#3A3A3A"/>
                    <TextBlock Text="Loading..."
                               FontSize="11"
                               Foreground="#6B6B6B"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Achievements List -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Achievements}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:AchievementCard DataContext="{Binding}"
                                                  ToggleCommand="{Binding DataContext.ToggleAchievementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  Margin="0,0,0,6"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Stats Editor Expander -->
        <Border Grid.Row="3"
                Background="#252525"
                CornerRadius="8"
                Margin="0,16,0,0">
            <StackPanel>
                <ToggleButton x:Name="StatsExpanderToggle"
                             IsChecked="{Binding IsStatsEditorExpanded, Mode=TwoWay}"
                             Cursor="Hand"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,14">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9F9;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="16"
                                                  Foreground="#66C0F4"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>
                                        <TextBlock Text="Stats Editor"
                                                  FontSize="15"
                                                  FontWeight="SemiBold"
                                                  Foreground="#FFFFFF"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="Edit game statistics"
                                                  FontSize="12"
                                                  Foreground="#6B6B6B"
                                                  VerticalAlignment="Center"
                                                  Margin="16,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="#6B6B6B"
                                               VerticalAlignment="Center"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=StatsExpanderToggle}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                                   To="180" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                                   To="0" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Border x:Name="StatsContent"
                        Padding="16,0,16,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=StatsExpanderToggle}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                <TextBlock Text="Select a stat or enter a custom name (stats are game-specific)"
                           FontSize="12"
                           Foreground="#6B6B6B"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableStats}"
                              SelectedItem="{Binding SelectedStat}"
                              Background="#1A1A1A"
                              Foreground="#FFFFFF"
                              BorderBrush="#3A3A3A"
                              BorderThickness="1"
                              Padding="12,10"
                              FontSize="13"
                              IsEditable="True"
                              Text="{Binding StatName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="1"
                               Text=" = "
                               Foreground="#6B6B6B"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="12,0"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding StatValue, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1A1A1A"
                             Foreground="#FFFFFF"
                             BorderBrush="#3A3A3A"
                             BorderThickness="1"
                             Padding="12,10"
                             FontSize="13"
                             CaretBrush="#66C0F4"/>
                    <Button Grid.Column="3"
                            Content="Get"
                            Command="{Binding GetStatCommand}"
                            Padding="20,10"
                            Margin="12,0,0,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#4A4A4A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Set"
                            Command="{Binding SetStatCommand}"
                            Padding="20,10"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#4A4A4A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Reset All Stats"
                            Command="{Binding ResetAllStatsCommand}"
                            Padding="20,10"
                            Margin="8,0,0,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3A2A2A"/>
                                <Setter Property="Foreground" Value="#E74C3C"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#4A2A2A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Save Stats"
                            Command="{Binding StoreStatsCommand}"
                            Padding="20,10"
                            Margin="16,0,0,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#66C0F4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#8FCDFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Smart Unlock Progress Overlay -->
        <Grid x:Name="SmartUnlockOverlayContainer"
              Grid.RowSpan="5"
              Visibility="{Binding IsSmartUnlockRunning, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:ProgressOverlay x:Name="SmartUnlockProgressOverlay"
                                  AppliedCount="{Binding SmartUnlockAppliedCount, Mode=OneWay}"
                                  ProtectedCount="{Binding SmartUnlockProtectedCount, Mode=OneWay}"
                                  FailedCount="{Binding SmartUnlockFailedCount, Mode=OneWay}"
                                  TotalCount="{Binding SmartUnlockTotal, Mode=OneWay}"
                                  StatusMessage="{Binding SmartUnlockStatusMessage, Mode=OneWay}"/>
        </Grid>
    </Grid>
</UserControl>
