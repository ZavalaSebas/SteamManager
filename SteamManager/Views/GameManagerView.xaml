<UserControl x:Class="SteamManager.Views.GameManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SteamManager.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#1A1A1A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="&#xE72B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Command="{Binding BackCommand}"
                    Background="Transparent"
                    Foreground="#888888"
                    BorderThickness="0"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Cursor="Hand"/>
            <TextBlock Text="{Binding SelectedGame.Name}"
                       FontSize="24"
                       FontWeight="Light"
                       Foreground="White"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Foreground="#666666" FontSize="13" VerticalAlignment="Center">
                <Run Text="{Binding UnlockedCount, Mode=OneWay}"/>
                <Run Text="/"/>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text=" achievements unlocked"/>
            </TextBlock>
            <TextBlock Text=" | "
                       Foreground="#444444"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <ProgressBar IsIndeterminate="True"
                          Width="100"
                          Height="8"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="Lock All"
                    Command="{Binding LockAllCommand}"
                    Background="#3A3A3A"
                    Foreground="White"
                    Padding="12,6"
                    BorderThickness="0"
                    Margin="16,0,0,0"
                    Cursor="Hand"/>
            <Button Content="Unlock All"
                    Command="{Binding UnlockAllCommand}"
                    Background="#3A3A3A"
                    Foreground="White"
                    Padding="12,6"
                    BorderThickness="0"
                    Margin="8,0,0,0"
                    Cursor="Hand"/>
            <Button Content="Select All"
                    Command="{Binding SelectAllCommand}"
                    Background="#3A3A3A"
                    Foreground="White"
                    Padding="10,6"
                    BorderThickness="0"
                    Margin="16,0,0,0"
                    Cursor="Hand"/>
            <Button Content="Deselect"
                    Command="{Binding DeselectAllCommand}"
                    Background="#3A3A3A"
                    Foreground="White"
                    Padding="10,6"
                    BorderThickness="0"
                    Margin="4,0,0,0"
                    Cursor="Hand"/>
            <TextBlock Text="Filter:"
                       Foreground="#666666"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="24,0,8,0"/>
            <Button Content="All"
                    Command="{Binding SetFilterAllCommand}"
                    Background="{Binding AchievementFilter, Converter={StaticResource FilterToBackgroundConverter}, ConverterParameter=All}"
                    Foreground="White"
                    Padding="10,6"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button Content="Unlocked"
                    Command="{Binding SetFilterUnlockedCommand}"
                    Background="{Binding AchievementFilter, Converter={StaticResource FilterToBackgroundConverter}, ConverterParameter=Unlocked}"
                    Foreground="White"
                    Padding="10,6"
                    BorderThickness="0"
                    Margin="4,0,0,0"
                    Cursor="Hand"/>
            <Button Content="Locked"
                    Command="{Binding SetFilterLockedCommand}"
                    Background="{Binding AchievementFilter, Converter={StaticResource FilterToBackgroundConverter}, ConverterParameter=Locked}"
                    Foreground="White"
                    Padding="10,6"
                    BorderThickness="0"
                    Margin="4,0,0,0"
                    Cursor="Hand"/>
            <Button Content="Hidden"
                    Command="{Binding SetFilterHiddenCommand}"
                    Background="{Binding AchievementFilter, Converter={StaticResource FilterToBackgroundConverter}, ConverterParameter=Hidden}"
                    Foreground="White"
                    Padding="10,6"
                    BorderThickness="0"
                    Margin="4,0,0,0"
                    Cursor="Hand"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Achievements}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:AchievementCard DataContext="{Binding}"
                                                  ToggleCommand="{Binding DataContext.ToggleAchievementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  Margin="0,0,0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Expander Grid.Row="3"
                  Header="Stats Editor"
                  IsExpanded="False"
                  Background="#252525"
                  Foreground="White"
                  BorderThickness="0"
                  Margin="0,16,0,0"
                  Padding="12">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Select a stat or enter a custom name (stats are game-specific)"
                           FontSize="11"
                           Foreground="#666666"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableStats}"
                              SelectedItem="{Binding SelectedStat}"
                              Background="#1A1A1A"
                              Foreground="White"
                              BorderBrush="#3A3A3A"
                              BorderThickness="1"
                              Padding="8,6"
                              FontSize="13"
                              IsEditable="True"
                              Text="{Binding StatName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="1"
                               Text=" = "
                               Foreground="#888888"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="8,0"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding StatValue, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1A1A1A"
                             Foreground="White"
                             BorderBrush="#3A3A3A"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="13"
                             CaretBrush="White"/>
                    <Button Grid.Column="3"
                            Content="Get"
                            Command="{Binding GetStatCommand}"
                            Background="#3A3A3A"
                            Foreground="White"
                            Padding="16,6"
                            BorderThickness="0"
                            Margin="8,0,0,0"
                            Cursor="Hand"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Set"
                            Command="{Binding SetStatCommand}"
                            Background="#3A3A3A"
                            Foreground="White"
                            Padding="16,6"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Content="Reset All Stats"
                            Command="{Binding ResetAllStatsCommand}"
                            Background="#3A3A3A"
                            Foreground="White"
                            Padding="16,6"
                            BorderThickness="0"
                            Margin="8,0,0,0"
                            Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="#666666"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <Button Content="Store Stats"
                    Command="{Binding StoreStatsCommand}"
                    Background="#3A3A3A"
                    Foreground="White"
                    Padding="16,8"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</UserControl>
