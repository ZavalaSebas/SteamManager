<UserControl x:Class="SteamManager.Views.GamePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SteamManager.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1A1A1A">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero Header with presence -->
        <Border Grid.Row="0"
                Padding="40,32,40,24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E1E1E" Offset="0"/>
                    <GradientStop Color="#232323" Offset="0.15"/>
                    <GradientStop Color="#1A1A1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                               ShadowDepth="4"
                               Direction="270"
                               Color="Black"
                               Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Main Title with accent -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Accent bar -->
                        <Border Width="4"
                                Height="36"
                                CornerRadius="2"
                                Margin="0,0,14,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#66C0F4" Offset="0"/>
                                    <GradientStop Color="#417A9B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="Game"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" Library"
                                   FontSize="40"
                                   FontWeight="Light"
                                   Foreground="#66C0F4"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>

                        <!-- Steam icon -->
                        <TextBlock Text="&#xE7BC;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="#3A3A3A"
                                   VerticalAlignment="Center"
                                   Margin="18,0,0,0"/>
                    </StackPanel>

                    <!-- Tagline -->
                    <TextBlock Text="Manage your achievements"
                               FontSize="13"
                               Foreground="#AAAAAA"
                               FontStyle="Italic"
                               Margin="18,6,0,0"/>
                </StackPanel>

                <!-- Search & Count -->
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Refresh Button -->
                    <Button Grid.Column="0"
                            Command="{Binding RefreshGamesCommand}"
                            ToolTip="Refresh games list"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <TextBlock Text="&#xE72C;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="18"
                                                           Foreground="#8A8A8A"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#66C0F4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Search Bar -->
                    <Border Grid.Column="1"
                            Background="#252525"
                            CornerRadius="8"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1"
                            Margin="8,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10"
                                           ShadowDepth="2"
                                           Direction="270"
                                           Color="Black"
                                           Opacity="0.3"/>
                        </Border.Effect>
                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#6B6B6B"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#66C0F4"
                                     BorderThickness="0"
                                     FontSize="14"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Game Count Badge -->
                    <Border Grid.Column="2"
                            Background="#252525"
                            CornerRadius="6"
                            Padding="14,8"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                           ShadowDepth="2"
                                           Direction="270"
                                           Color="Black"
                                           Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Games.Count}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#66C0F4"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" games"
                                       FontSize="13"
                                       Foreground="#8A8A8A"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Type Filter Bar -->
        <Border Grid.Row="1"
                Padding="40,0,40,12"
                Background="#1A1A1A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Chips -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Show:"
                               Foreground="#AAAAAA"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ToggleButton IsChecked="{Binding ShowGames}"
                                  Content="Games"
                                  FontSize="12"
                                  Padding="14,6"
                                  Margin="0,0,8,0"
                                  Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#8A8A8A"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A4A6B"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#66C0F4"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2E2E2E"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="border" Property="Background" Value="#3A5A7B"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowDemos}"
                                  Content="Demos"
                                  FontSize="12"
                                  Padding="14,6"
                                  Margin="0,0,8,0"
                                  Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#8A8A8A"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A4A6B"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#66C0F4"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2E2E2E"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="border" Property="Background" Value="#3A5A7B"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowMods}"
                                  Content="Mods"
                                  FontSize="12"
                                  Padding="14,6"
                                  Margin="0,0,8,0"
                                  Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#8A8A8A"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A4A6B"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#66C0F4"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2E2E2E"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="border" Property="Background" Value="#3A5A7B"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowJunk}"
                                  Content="Junk"
                                  FontSize="12"
                                  Padding="14,6"
                                  Margin="0,0,8,0"
                                  Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#8A8A8A"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A4A6B"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#66C0F4"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2E2E2E"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="border" Property="Background" Value="#3A5A7B"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>

                <!-- Add Game -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#252525"
                            CornerRadius="6"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1"
                            Height="30">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Add:"
                                       Foreground="#AAAAAA"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding AddGameAppId, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#66C0F4"
                                     BorderThickness="0"
                                     FontSize="12"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Command="{Binding AddGameCommand}"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Margin="8,0,0,0"
                            ToolTip="Add game by App ID"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="&#xE710;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16"
                                                           Foreground="#8A8A8A"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#66C0F4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Games Area with Background -->
        <Grid Grid.Row="2"
              Margin="0,8,0,0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#181818" Offset="0"/>
                    <GradientStop Color="#1A1A1A" Offset="0.3"/>
                    <GradientStop Color="#1A1A1A" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Loading Skeleton -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="32,0,32,0"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                    <controls:SkeletonCard/>
                </ItemsControl>
            </ScrollViewer>

            <!-- Games Grid -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="32,0,32,0"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Games}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:GameCard DataContext="{Binding}"
                                              GameSelected="GameCard_GameSelected"
                                              FavoriteToggle="GameCard_FavoriteToggle"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
